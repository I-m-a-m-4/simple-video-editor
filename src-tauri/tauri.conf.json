{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "OpenCut",
  "version": "0.1.0",
  "identifier": "com.opencut.app",
  "build": {
    "beforeDevCommand": "bun dev:web",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun build:web",
    "frontendDist": "../apps/web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCut - Video Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "CN=OpenCut",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
